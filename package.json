{
  "name": "hobos-songbook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "node node_modules/typescript-7/bin/tsc",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "test": "node --test tests/*.test.mjs",
    "check:quick": "npm run format:check && npm run lint && npm run typecheck && node scripts/check.mjs",
    "check": "npm run check:quick && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.15.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-playwright": "2.12.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
