{
  "name": "hobos-songbook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && node scripts/check.mjs && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
