{
  "permissions": {
    "ask": ["Edit(/src/theme.css)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.mjs\""
          }
        ]
      }
    ]
  }
}
